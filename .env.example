# =============================================================================
# BU-TING Mobile — 로컬 환경 변수
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git에 올라가지 않습니다)
# =============================================================================

# --- Google Maps Platform (Places API) ---
# https://console.cloud.google.com/google/maps-apis
# Find Place / Place Details 연동용 (TourAPI place_id 역추적·상세 조회)
GOOGLE_PLACES_API_KEY=

# Find Place locationbias 원 반경 (미터). 공공데이터 좌표 오차 대비 50~200 권장
GOOGLE_PLACES_FIND_RADIUS_M=150

# Find Place·Details 응답 언어
GOOGLE_PLACES_LANGUAGE=ko

# --- Backend API ---
# OAuth 로그인·API 요청용 백엔드 기본 URL (끝에 / 없이)
API_BASE_URL=https://api.buting.store

# --- Google OAuth (Sign-In SDK) ---
# Firebase/Google Cloud Console → OAuth 2.0 클라이언트 ID
# Android/iOS 네이티브 클라이언트와 별도로 Web client ID가 필요합니다.
GOOGLE_OAUTH_WEB_CLIENT_ID=
GOOGLE_OAUTH_IOS_CLIENT_ID=
GOOGLE_OAUTH_ANDROID_CLIENT_ID_FOR_DEBUG=
GOOGLE_OAUTH_ANDROID_CLIENT_ID_FOR_RELEASE=

# --- Kakao ---
# https://developers.kakao.com/console/app → 앱 키
# 로그인·백엔드 검증은 동일 카카오 앱이어야 함 (네이티브 앱 키 앱 = REST API 키 앱)
# 지도(WebView)용 JavaScript 키 — 로그인 앱과 다를 수 있음
KAKAO_JAVASCRIPT_KEY=
# 로그인 SDK용 네이티브 앱 키 (미설정 시 KAKAO_JAVASCRIPT_KEY를 임시 사용)
KAKAO_NATIVE_APP_KEY=

# --- Naver OAuth (현재 비활성화 — 앱 등록 후 사용) ---
# 활성화: src/constants/oauthProviders.ts 의 NAVER_OAUTH_ENABLED=true
#         + .env 에 NAVER_OAUTH_ENABLED=true
# NAVER_OAUTH_ENABLED=false
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# NAVER_APP_NAME=부팅
# NAVER_URL_SCHEME=butingnaverlogin

# --- ngrok (Metro USB/LAN 없이 실기기 연결) ---
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
