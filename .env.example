# =============================================================================
# BU-TING Mobile — 로컬 환경 변수
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git에 올라가지 않습니다)
# OAuth 키 입력 후 npm run oauth:sync — AndroidManifest.xml·Info.plist·oauth_strings.xml 생성/갱신
# =============================================================================

# --- Backend API ---
# OAuth 로그인·API 요청용 백엔드 기본 URL (끝에 / 없이)
API_BASE_URL=https://api.buting.store

# --- Google OAuth (Sign-In SDK) ---
# Firebase/Google Cloud Console → OAuth 2.0 클라이언트 ID
# Android/iOS 네이티브 클라이언트와 별도로 Web client ID가 필요합니다.
# Web client — 백엔드 토큰 검증용 (custom scheme redirect URI 등록 불가)
GOOGLE_OAUTH_WEB_CLIENT_ID=
# iOS OAuth client — iOS 앱 로그인·redirect scheme용
GOOGLE_OAUTH_IOS_CLIENT_ID=
# Android OAuth client — 앱 로그인·redirect scheme용 (debug/release 각각 콘솔에 패키지+SHA-1 등록)
# redirect_uri 예: com.googleusercontent.apps.{ANDROID_CLIENT_PREFIX}:/oauth2redirect
# ⚠ Google Cloud Console → 해당 Android 클라이언트 → Advanced settings →
#   "Custom URI scheme" redirect method 를 켜야 합니다 (기본 OFF → "sent an invalid request" 오류)
GOOGLE_OAUTH_ANDROID_CLIENT_ID_FOR_DEBUG=
GOOGLE_OAUTH_ANDROID_CLIENT_ID_FOR_RELEASE=

# --- Kakao ---
# https://developers.kakao.com/console/app → 앱 키
# 로그인 authorize client_id = REST API 키 (KAKAO_REST_API_KEY)
# redirect_uri: kakao{NATIVE_APP_KEY}://oauth (REST API 키 Redirect URI에 등록)
KAKAO_REST_API_KEY=
# 지도(WebView)용 JavaScript 키 — 로그인 앱과 다를 수 있음
KAKAO_JAVASCRIPT_KEY=
# 로그인 SDK용 네이티브 앱 키 (미설정 시 KAKAO_JAVASCRIPT_KEY를 임시 사용)
KAKAO_NATIVE_APP_KEY=

# --- Naver OAuth (현재 비활성화 — 앱 등록 후 사용) ---
# 활성화: src/constants/oauthProviders.ts 의 NAVER_OAUTH_ENABLED=true
#         + .env 에 NAVER_OAUTH_ENABLED=true
# NAVER_OAUTH_ENABLED=false
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# NAVER_APP_NAME=부팅
# NAVER_URL_SCHEME=butingnaverlogin

# --- ngrok (Metro USB/LAN 없이 실기기 연결) ---
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# --- Zone chat WebSocket (백엔드 준비 후) ---
# src/constants/chat/zoneChatConfig.ts 와 맞춰 사용
# ZONE_CHAT_WS_ENABLED=false
# ZONE_CHAT_WS_URL=
# ZONE_CHAT_IDENTITY_FIELD=userId
# 핸드셰이크 Origin (nginx CORS). 미설정 시 RN Android 가 API 호스트 Origin 을 자동 추가합니다.
ZONE_CHAT_WS_HANDSHAKE_ORIGIN=https://dev.buting.store
